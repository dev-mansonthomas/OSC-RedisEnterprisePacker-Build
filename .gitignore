# Fichiers de cache et bytecode Python
__pycache__/
*.py[cod]
*$py.class

# Répertoires d'environnements virtuels
venv/
virtualenv/
env/
.venv/
.env/

# Fichiers de configuration spécifiques à l'IDE
.idea/
.vscode/
*.swp

# Fichiers de dépendances et de build
build/
dist/
*.egg-info/
*.egg

# Fichiers de logs
*.log

# Fichiers de base de données locaux
.sqlite3
db.sqlite3

# Fichiers de tests et de couverture
.pytest_cache/
.coverage
htmlcov/

# Fichiers secrets et de configuration locale
.env.*
*.env
secrets.toml

# Fichiers specifiques
# Le tarball Redis Enterprise (~350 Mo-1 Go) n'est pas redistribuable.
redis-software/*
# ...mais on garde la trace des empreintes verifiees (cf. fetch_redis_tarball.sh).
!redis-software/SHA256SUMS
# Artefacts de build. ATTENTION: manifest.json est REQUIS par
# build_and_deploy_redis_image_with_packer.sh pour extraire l'OMI ID -- ne pas le
# supprimer localement, il porte aussi l'historique des builds (cf. TODO T-33).
build_scripts/manifest.json
build_scripts/packer.out
build_scripts/install.log
.DS_Store
# Configuration locale de l'operateur: contient les IDs de ressources generes.
_my_env.sh
# Materiel de cle privee, quelle que soit sa provenance.
*.pem
*.key
*.rsa
id_rsa*
